# Configuration exemple pour PlaygroundSpot (SaaS Réservation Terrains Foot Dakar)

# Supabase Frontend
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_anon_key

# Feature Flags Paiement (Défaut : 'false' si absent)
# VITE_PAIEMENT_RESERVATION_ACTIF : Active le paiement mobile en ligne (Wave / Orange Money) pour les joueurs
VITE_PAIEMENT_RESERVATION_ACTIF=false

# VITE_PAIEMENT_ABONNEMENT_ACTIF : Active le paiement en ligne des abonnements/boosts gérants
VITE_PAIEMENT_ABONNEMENT_ACTIF=false

# URL de développement API
VITE_API_URL=http://localhost:5173/

# Clés Serveur (Supabase / UnitechPay) - NE JAMAIS EXPOSER DANS LE BUNDLE FRONTEND
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key
UNITECH_API_KEY=votre_unitech_key
